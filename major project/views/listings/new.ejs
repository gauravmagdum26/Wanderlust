
<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center">
  <div class="col-md-7">
    <h3 class="mb-4">Add New Listing</h3>

    <form method="POST" action="/listing" enctype="multipart/form-data">

      <div class="mb-3">
        <label class="form-label">Title</label>
        <input name="list[title]" class="form-control" placeholder="Enter title" type="text" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="list[description]" class="form-control" placeholder="Enter description"></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Image</label>
        <input name="list[image]" class="form-control" type="file" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Price (₹)</label>
        <input name="list[price]" class="form-control" placeholder="Enter price" type="number" min="0" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Country</label>
        <input name="list[country]" class="form-control" placeholder="Enter country" type="text" />
      </div>

      <div class="mb-3">
        <label class="form-label">Location</label>
        <input name="list[location]" class="form-control" placeholder="Enter location" type="text" />
      </div>

      <button class="btn btn-primary">Add Listing</button>
    </form>
  </div>
</div>