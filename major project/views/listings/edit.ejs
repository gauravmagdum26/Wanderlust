
<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center">
  <div class="col-md-7">
    <h3 class="mb-4">Update Listing</h3>

    <form method="POST" action="/listing/<%= list.id %>?_method=put" enctype="multipart/form-data">

      <div class="mb-3">
        <label class="form-label">Title</label>
        <input name="list[title]" class="form-control" placeholder="Enter title" value="<%= list.title %>" type="text" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="list[description]" class="form-control" placeholder="Enter description"><%= list.description %></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Current Image</label><br>
        <% if (list.image && list.image.url) { %>
          <img src="<%= list.image.url %>" alt="<%= list.title %>" class="img-thumbnail mb-2" style="max-height: 200px;">
        <% } %>
        <input name="list[image]" class="form-control" type="file" />
        <small class="text-muted">Leave blank to keep the current image.</small>
      </div>

      <div class="mb-3">
        <label class="form-label">Price (₹)</label>
        <input name="list[price]" class="form-control" placeholder="Enter price" value="<%= list.price %>" type="number" min="0" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Country</label>
        <input name="list[country]" class="form-control" placeholder="Enter country" value="<%= list.country %>" type="text" />
      </div>

      <div class="mb-3">
        <label class="form-label">Location</label>
        <input name="list[location]" class="form-control" placeholder="Enter location" value="<%= list.location %>" type="text" />
      </div>

      <button class="btn btn-success">Update Listing</button>
    </form>
  </div>
</div>