
<% layout("/layouts/boilerplate") %>

<!-- <body> -->
    <div class="container mt-4 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                
                <h2 class="mb-4 text-center">Listing Details</h2>
                
                <div class="card shadow-sm mb-4">
                    <% if (list.image && list.image.url) { %>
                        <img src="<%= list.image.url %>" class="card-img-top" alt="<%= list.title %>" style="height: 350px; object-fit: cover;">
                        <% } else { %>
                            <img src="https://via.placeholder.com/800x350?text=No+Image+Available" class="card-img-top" alt="No image">
                            <% } %>
                            
                            <div class="card-body">
                                <h3 class="card-title"><%= list.title %></h3>
                                <p class="card-text"><%= list.description %></p>
                                
                                <ul class="list-group list-group-flush mb-3">
                                    <li class="list-group-item">
                                        <strong>Price:</strong>
                                        &#8377;<%= list.price != null ? list.price.toLocaleString("en-IN") : "N/A" %>
                                    </li>
                                    <li class="list-group-item"><strong>Location:</strong> <%= list.location %></li>
                                    <li class="list-group-item"><strong>Country:</strong> <%= list.country %></li>
                                </ul>
                                
                                <div class="d-flex gap-2">
                                    <a href="/listing/<%= list.id %>/edit" class="btn btn-outline-primary">Edit Listing</a>
                                    <form method="post" action="/listing/<%= list.id %>?_method=delete" class="d-inline">
                                        <button class="btn btn-outline-danger" type="submit">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        
                        <h4 class="mb-2">Map Location</h4>
                        <p id="distance-info" class="fw-bold text-primary"></p>
                        <div id="map" style="height: 400px; width: 100%; border-radius: 8px;"></div>
                        
                    </div>
                </div>
            </div>
            
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
            <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
            <script>
                const lodgeLat = Number("<%= list.lat || 0 %>");
                const lodgeLng = Number("<%= list.lng || 0 %>");
                const lodgeTitle = "<%= list.title %>";
                
                const map = L.map('map').setView([lodgeLat, lodgeLng], 13);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap'
    }).addTo(map);
    
    L.marker([lodgeLat, lodgeLng]).addTo(map)
    .bindPopup(`<b>${lodgeTitle}</b>`).openPopup();
    
    if (navigator.geolocation && lodgeLat !== 0) {
        navigator.geolocation.getCurrentPosition((pos) => {
        const userLat = pos.coords.latitude;
        const userLng = pos.coords.longitude;

        L.circleMarker([userLat, userLng], { color: 'red', fillColor: '#f03', fillOpacity: 0.2, radius: 50 }).addTo(map)
          .bindPopup('You are here');

        const distanceInKm = (L.latLng(userLat, userLng).distanceTo(L.latLng(lodgeLat, lodgeLng)) / 1000).toFixed(2);
        document.getElementById('distance-info').innerText = `This location is ${distanceInKm} km away from you.`;

        map.fitBounds([[userLat, userLng], [lodgeLat, lodgeLng]], { padding: [50, 50] });
      });
    }
  </script>
